{
  "name": "reader",
  "version": "1.0.0",
  "description": "EPUB Reader with AI Features",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"app/**/*.{ts,tsx,css,json}\" \"components/**/*.{ts,tsx}\" \"hooks/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"shared/**/*.{ts,tsx}\" \"util/**/*.{ts,tsx}\" \"*.{json,md,yml,yaml,ts,tsx,mjs}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css,json}\" \"components/**/*.{ts,tsx}\" \"hooks/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"shared/**/*.{ts,tsx}\" \"util/**/*.{ts,tsx}\" \"*.{json,md,yml,yaml,ts,tsx,mjs}\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@vercel/blob": "^2.3.3",
    "epub": "^2.1.1",
    "lucide-react": "^0.460.0",
    "next": "^16.2.6",
    "openai": "^4.52.7",
    "postgres": "^3.4.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.17.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/sanitize-html": "^2.16.1",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.18",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.6.0"
  }
}
